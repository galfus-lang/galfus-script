import { println } from "std/io"
import { now } from "std/time"
import { concat } from "text"
import { stringify } from "format"

fn matrix4_i32(): i32 {
  var a00: i32 = 1
  var a01: i32 = 2
  var a02: i32 = 3
  var a03: i32 = 4
  var a10: i32 = 5
  var a11: i32 = 6
  var a12: i32 = 7
  var a13: i32 = 8
  var a20: i32 = 9
  var a21: i32 = 10
  var a22: i32 = 11
  var a23: i32 = 12
  var a30: i32 = 13
  var a31: i32 = 14
  var a32: i32 = 15
  var a33: i32 = 16
  const b00: i32 = 1
  const b01: i32 = 2
  const b02: i32 = 3
  const b03: i32 = 4
  const b10: i32 = 2
  const b11: i32 = 1
  const b12: i32 = 4
  const b13: i32 = 3
  const b20: i32 = 3
  const b21: i32 = 4
  const b22: i32 = 1
  const b23: i32 = 2
  const b30: i32 = 4
  const b31: i32 = 3
  const b32: i32 = 2
  const b33: i32 = 1
  var checksum: i32 = 0

  for _ in 0..1000000 {
    const c00 = (a00 * b00 + a01 * b10 + a02 * b20 + a03 * b30) % 1009
    const c01 = (a00 * b01 + a01 * b11 + a02 * b21 + a03 * b31) % 1009
    const c02 = (a00 * b02 + a01 * b12 + a02 * b22 + a03 * b32) % 1009
    const c03 = (a00 * b03 + a01 * b13 + a02 * b23 + a03 * b33) % 1009
    const c10 = (a10 * b00 + a11 * b10 + a12 * b20 + a13 * b30) % 1009
    const c11 = (a10 * b01 + a11 * b11 + a12 * b21 + a13 * b31) % 1009
    const c12 = (a10 * b02 + a11 * b12 + a12 * b22 + a13 * b32) % 1009
    const c13 = (a10 * b03 + a11 * b13 + a12 * b23 + a13 * b33) % 1009
    const c20 = (a20 * b00 + a21 * b10 + a22 * b20 + a23 * b30) % 1009
    const c21 = (a20 * b01 + a21 * b11 + a22 * b21 + a23 * b31) % 1009
    const c22 = (a20 * b02 + a21 * b12 + a22 * b22 + a23 * b32) % 1009
    const c23 = (a20 * b03 + a21 * b13 + a22 * b23 + a23 * b33) % 1009
    const c30 = (a30 * b00 + a31 * b10 + a32 * b20 + a33 * b30) % 1009
    const c31 = (a30 * b01 + a31 * b11 + a32 * b21 + a33 * b31) % 1009
    const c32 = (a30 * b02 + a31 * b12 + a32 * b22 + a33 * b32) % 1009
    const c33 = (a30 * b03 + a31 * b13 + a32 * b23 + a33 * b33) % 1009
    a00 = c00
    a01 = c01
    a02 = c02
    a03 = c03
    a10 = c10
    a11 = c11
    a12 = c12
    a13 = c13
    a20 = c20
    a21 = c21
    a22 = c22
    a23 = c23
    a30 = c30
    a31 = c31
    a32 = c32
    a33 = c33
    checksum = (checksum + a00 + a11 + a22 + a33) % 1009
  }
  return checksum
}

fn matrix4_f32(): f32 {
  var a00: f32 = <f32> 1.0
  var a01: f32 = <f32> 2.0
  var a02: f32 = <f32> 3.0
  var a03: f32 = <f32> 4.0
  var a10: f32 = <f32> 5.0
  var a11: f32 = <f32> 6.0
  var a12: f32 = <f32> 7.0
  var a13: f32 = <f32> 8.0
  var a20: f32 = <f32> 9.0
  var a21: f32 = <f32> 10.0
  var a22: f32 = <f32> 11.0
  var a23: f32 = <f32> 12.0
  var a30: f32 = <f32> 13.0
  var a31: f32 = <f32> 14.0
  var a32: f32 = <f32> 15.0
  var a33: f32 = <f32> 16.0
  const b00: f32 = <f32> 1.0
  const b01: f32 = <f32> 2.0
  const b02: f32 = <f32> 3.0
  const b03: f32 = <f32> 4.0
  const b10: f32 = <f32> 2.0
  const b11: f32 = <f32> 1.0
  const b12: f32 = <f32> 4.0
  const b13: f32 = <f32> 3.0
  const b20: f32 = <f32> 3.0
  const b21: f32 = <f32> 4.0
  const b22: f32 = <f32> 1.0
  const b23: f32 = <f32> 2.0
  const b30: f32 = <f32> 4.0
  const b31: f32 = <f32> 3.0
  const b32: f32 = <f32> 2.0
  const b33: f32 = <f32> 1.0
  var checksum: f32 = <f32> 0.0

  for _ in 0..1000000 {
    const c00 = (a00 * b00 + a01 * b10 + a02 * b20 + a03 * b30) % <f32> 1009.0
    const c01 = (a00 * b01 + a01 * b11 + a02 * b21 + a03 * b31) % <f32> 1009.0
    const c02 = (a00 * b02 + a01 * b12 + a02 * b22 + a03 * b32) % <f32> 1009.0
    const c03 = (a00 * b03 + a01 * b13 + a02 * b23 + a03 * b33) % <f32> 1009.0
    const c10 = (a10 * b00 + a11 * b10 + a12 * b20 + a13 * b30) % <f32> 1009.0
    const c11 = (a10 * b01 + a11 * b11 + a12 * b21 + a13 * b31) % <f32> 1009.0
    const c12 = (a10 * b02 + a11 * b12 + a12 * b22 + a13 * b32) % <f32> 1009.0
    const c13 = (a10 * b03 + a11 * b13 + a12 * b23 + a13 * b33) % <f32> 1009.0
    const c20 = (a20 * b00 + a21 * b10 + a22 * b20 + a23 * b30) % <f32> 1009.0
    const c21 = (a20 * b01 + a21 * b11 + a22 * b21 + a23 * b31) % <f32> 1009.0
    const c22 = (a20 * b02 + a21 * b12 + a22 * b22 + a23 * b32) % <f32> 1009.0
    const c23 = (a20 * b03 + a21 * b13 + a22 * b23 + a23 * b33) % <f32> 1009.0
    const c30 = (a30 * b00 + a31 * b10 + a32 * b20 + a33 * b30) % <f32> 1009.0
    const c31 = (a30 * b01 + a31 * b11 + a32 * b21 + a33 * b31) % <f32> 1009.0
    const c32 = (a30 * b02 + a31 * b12 + a32 * b22 + a33 * b32) % <f32> 1009.0
    const c33 = (a30 * b03 + a31 * b13 + a32 * b23 + a33 * b33) % <f32> 1009.0
    a00 = c00
    a01 = c01
    a02 = c02
    a03 = c03
    a10 = c10
    a11 = c11
    a12 = c12
    a13 = c13
    a20 = c20
    a21 = c21
    a22 = c22
    a23 = c23
    a30 = c30
    a31 = c31
    a32 = c32
    a33 = c33
    checksum = (checksum + a00 + a11 + a22 + a33) % <f32> 1009.0
  }
  return checksum
}

export fn main(_args: [[u8]]): i32 {
  const start = now()
  const integer_result = matrix4_i32()
  const float_result = matrix4_f32()
  const end = now()
  println(concat("RESULT=", concat(stringify(integer_result), concat(",", stringify(float_result)))))
  println(concat("TIME_MS=", stringify(end - start)))
  return 0
}
