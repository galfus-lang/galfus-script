fn(async) __internal_thread_create(func: fn([[u8]]): i32, key: [u8] | null): i64
fn(async) __internal_thread_get(key: [u8]): i64
fn(async) __internal_thread_spawn(id: i64, args: [[u8]] | null): bool
fn(async) __internal_thread_is_running(id: i64): bool
fn(async) __internal_thread_is_exited(id: i64): bool
fn(async) __internal_thread_exit_reason(id: i64): i32 | null
fn(async) __internal_thread_send(id: i64, data: [u8]): bool
fn(async) __internal_thread_receive(id: i64, timeout: i32): [u8] | null
fn(async) __internal_thread_has_messages(): bool
fn(async) __internal_thread_get_message(): [u8] | null
fn(async) __internal_thread_wait(id: i64): i32 | null
fn(async) __internal_thread_sleep(ms: i32): null

export struct Thread {
    id: i64,
    key: [u8] | null
}

export fn createThread(func: fn([[u8]]): i32, key: [u8] | null = null): Thread {
    return new(Thread) { 
        id: await __internal_thread_create(func, key), 
        key: key 
    }
}

export fn getThread(key: [u8]): Thread | null {
    const id = await __internal_thread_get(key)
    if id == -1 {
        return null
    }
    return new(Thread) { id: id, key: key }
}

export fn hasMessages(): bool {
    return await __internal_thread_has_messages()
}

export fn getMessage(): [u8] | null {
    return await __internal_thread_get_message()
}

fn Thread::spawn(self, args: [[u8]] | null = null): bool {
    return await __internal_thread_spawn(self.id, args)
}

fn Thread::isRunning(self): bool {
    return await __internal_thread_is_running(self.id)
}

fn Thread::isExited(self): bool {
    return await __internal_thread_is_exited(self.id)
}

fn Thread::exitReason(self): i32 | null {
    return await __internal_thread_exit_reason(self.id)
}

fn Thread::send(self, data: [u8]): bool {
    return await __internal_thread_send(self.id, data)
}

fn Thread::tryReceiveMessage(self, timeout: i32): [u8] | null {
    return await __internal_thread_receive(self.id, timeout)
}

fn Thread::wait(self): i32 | null {
    return await __internal_thread_wait(self.id)
}

export fn sleep(ms: i32): null {
    await __internal_thread_sleep(ms)
}
