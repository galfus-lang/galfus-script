fn(async) __provider_io_write(text: [u8]): null
fn(async) __provider_io_read(terminator: [u8]): [u8]

export fn read(terminator: [u8] = "\n"): [u8] {
  return await __provider_io_read(terminator)
}

export fn print(text: [u8]): null {
  await __provider_io_write(text)
}

export fn println(text: [u8]): null {
  await __provider_io_write(text)
  await __provider_io_write([<u8>10])
}
