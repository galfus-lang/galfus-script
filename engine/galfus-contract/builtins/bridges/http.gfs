export struct Header {
    name: [u8],
    value: [u8],
}

export struct Response {
    status: i32,
    headers: [Header],
    body: [u8],
}

fn(async) __provider_http_request(method: [u8], url: [u8], headers: [Header], body: [u8] | null): Response | null

export fn request(method: [u8], url: [u8], headers: [Header] = [], body: [u8] | null = null): Response | null {
  return await __provider_http_request(method, url, headers, body)
}
