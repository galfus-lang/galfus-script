import { Thread, createThread, getSelfId, receiveMessage, sendToParent, sendTo } from "std/thread"
import { Future } from "std/async"
import { ReadStream, ReadStreamResult, BytesStream } from "std/stream"
import { parse, ParseResult, stringify } from "format"

export struct URL {
    href: [u8],
    protocol: [u8],
    host: [u8],
    hostname: [u8],
    pathname: [u8],
    search: [u8],
    hash: [u8],
    origin: [u8]
}

export fn getPathname(url: URL): [u8] => url.pathname

export type Header = ([u8], [u8])

export fn header(name: [u8], value: [u8]): ([u8], [u8]) => (name, value)

export struct RequestBody satisfies ReadStream<[u8]> {
    id: u64,
    closed: bool
}


choice ProviderReadResult {
    Data([u8]),
    End,
    Error([u8])
}

export struct Request {
    id: u64,
    url: URL,
    method: [u8],
    headers: [Header],
    body: RequestBody
}

struct ProviderRequest {
    id: u64,
    url: URL,
    method: [u8],
    headers: [Header],
    body: u64
}

export struct Response {
    status: i32 = 200,
    headers: [Header] = [],
    body: ReadStream<[u8]> | null = null
}


export fn fromBytes(bytes: [u8]): Response {
    return new(Response) {
        status: 200,
        headers: [],
        body: new(BytesStream) { bytes: bytes, cancelled: false }
    }
}

export fn upgradeToWs(): Response {
    return new(Response) {
        status: 101,
        headers: []
    }
}
// Compatibility helper for code that builds responses outside a struct literal.
// A WebSocket upgrade is represented by HTTP status 101, not a struct field.
export fn createResponse(status: i32, headers: [Header], body: ReadStream<[u8]> | null, is_ws_upgrade: bool): Response {
    if is_ws_upgrade {
        return new(Response) {
            status: 101,
            headers: headers,
            body: body
        }
    }
    return new(Response) {
        status: status,
        headers: headers,
        body: body
    }
}
export struct WebSocket {
    id: u64
}

export fn(async) ws_send(ws: WebSocket, data: [u8]): bool {
    return await __provider_server_ws_send(ws.id, data)
}

export fn(async) ws_close(ws: WebSocket): bool {
    return await __provider_server_ws_close(ws.id)
}

export struct WsMessage {
    status: i32,
    msg: [u8] | null
}

fn(async) __provider_server_bind(port: i32, max_pending_requests: u32): u64
fn(async) __provider_server_accept(server_id: u64): u64
fn(async) __provider_server_request_get(request_id: u64): ProviderRequest | null
fn(async) __provider_server_response_start(req_id: u64, status: i32, headers: [([u8], [u8])], is_upgrade: bool): bool
fn(async) __provider_server_response_write(req_id: u64, chunk: [u8]): bool
fn(async) __provider_server_response_finish(req_id: u64): bool
fn(async) __provider_server_response_abort(req_id: u64): bool
fn(async) __provider_server_request_read(request_id: u64, max_bytes: u32): ProviderReadResult
fn(async) __provider_server_request_close(request_id: u64): bool
fn(async) __provider_server_ws_receive(ws_id: u64): WsMessage | null
fn(async) __provider_server_ws_send(ws_id: u64, data: [u8]): bool
fn(async) __provider_server_ws_close(ws_id: u64): bool

export fn(async) RequestBody::next(self): ReadStreamResult<[u8]> {
    if self.closed {
        return ReadStreamResult::End
    }

    const result = await __provider_server_request_read(self.id, 65536)
    var ret: ReadStreamResult<[u8]> = ReadStreamResult<[u8]>::End
    match result {
        ProviderReadResult::Data(chunk) { ret = ReadStreamResult::Data<[u8]>(chunk) },
        ProviderReadResult::End {
            self.closed = true
            ret = ReadStreamResult<[u8]>::End
        },
        ProviderReadResult::Error(msg) {
            self.closed = true
            ret = ReadStreamResult::Error<[u8]>(msg)
        }
    }
    return ret
}

export fn(async) RequestBody::cancel(self): null {
    if !self.closed {
        self.closed = true
        await __provider_server_request_close(self.id)
    }
    return null
}

export struct WebSocketConfig {
    onOpen: fn(WebSocket, i32): null,
    onMessage: fn(WebSocket, i32, [u8]): null,
    onClose: fn(WebSocket, i32): null,
    onError: fn(WebSocket, i32, [u8]): null
}

export fn createWebSocketConfig(
    onOpenCb: fn(WebSocket, i32): null,
    onMessageCb: fn(WebSocket, i32, [u8]): null,
    onCloseCb: fn(WebSocket, i32): null,
    onErrorCb: fn(WebSocket, i32, [u8]): null
): WebSocketConfig {
    return new(WebSocketConfig) {
        onOpen: onOpenCb,
        onMessage: onMessageCb,
        onClose: onCloseCb,
        onError: onErrorCb
    }
}

export struct Server {
    port: i32,
    handlers: i32 = 32,
    fetch: fn(Request): Future<Response>,
    websocket: WebSocketConfig
}

export fn createServer(port: i32, fetch: fn(Request): Future<Response>, websocket: WebSocketConfig, handlers: i32 = 32): Server {
    return new(Server) {
        port: port,
        handlers: handlers,
        fetch: fetch,
        websocket: websocket
    }
}

struct HttpHandlerContext {
    fetch: fn(Request): Future<Response>,
    websocket: WebSocketConfig
}

struct WebSocketHandlerContext {
    socket: WebSocket,
    status: i32,
    config: WebSocketConfig
}

struct HttpHandlerPool {
    available: [i64],
    availableCount: i32,
    busy: [i64],
    busyCount: i32
}

fn HttpHandlerPool::create(capacity: i32): HttpHandlerPool {
    return new(HttpHandlerPool) {
        available: new([i64], capacity),
        availableCount: 0,
        busy: new([i64], capacity),
        busyCount: 0
    }
}

fn HttpHandlerPool::addAvailable(self, handlerId: i64): bool {
    if self.availableCount >= self.available.length {
        return false
    }
    self.available[self.availableCount] = handlerId
    self.availableCount += 1
    return true
}

fn HttpHandlerPool::takeAvailable(self): i64 | null {
    if self.availableCount <= 0 {
        return null
    }
    self.availableCount -= 1
    return self.available[self.availableCount]
}

fn HttpHandlerPool::addBusy(self, handlerId: i64): bool {
    if self.busyCount >= self.busy.length {
        return false
    }
    self.busy[self.busyCount] = handlerId
    self.busyCount += 1
    return true
}

fn HttpHandlerPool::release(self, handlerId: i64): bool {
    var index: i32 = 0
    loop {
        if index >= self.busyCount {
            return false
        }
        if self.busy[index] == handlerId {
            self.busyCount -= 1
            self.busy[index] = self.busy[self.busyCount]
            return self::addAvailable(handlerId)
        }
        index += 1
    }
    return false
}

fn HttpHandlerPool::drainCompleted(self): null {
    var index: i32 = 0
    loop {
        if index >= self.busyCount {
            break
        }
        instanceof self.busy[index] {
            i64 handlerId {
                const handler = new(Thread) { id: handlerId, key: null }
                const completed = handler::tryReceiveMessage()
                instanceof completed {
                    [u8] data { self::release(handlerId) },
                    null { index += 1 }
                }
            },
            null { index += 1 }
        }
    }
    return null
}

fn(async) writeResponse(requestId: u64, response: Response): bool {
    const status = response.status
    const isUpgrade = status == 101
    const headers = copy response.headers
    const body = copy response.body

    if !(await __provider_server_response_start(requestId, status, headers, isUpgrade)) {
        return false
    }

    instanceof body {
        null { return await __provider_server_response_finish(requestId) },
        ReadStream<[u8]> stream {
            var aborted = false
            loop {
                const chunkResult = await stream::next()
                match chunkResult {
                    ReadStreamResult::Data(chunk) {
                        if !(await __provider_server_response_write(requestId, chunk)) {
                            aborted = true
                            break
                        }
                    },
                    ReadStreamResult::End { break },
                    ReadStreamResult::Error(_) {
                        aborted = true
                        break
                    }
                }
            }
            if aborted {
                return await __provider_server_response_abort(requestId)
            }
            return await __provider_server_response_finish(requestId)
        }
    }
    return false
}

fn webSocketHandler(context: WebSocketHandlerContext): i32 {
    const socket = copy context.socket
    const config = copy context.config
    const onOpen = config.onOpen
    onOpen(copy socket, context.status)

    loop {
        const payload = await __provider_server_ws_receive(socket.id)
        instanceof payload {
            null { break },
            WsMessage message {
                const status = message.status
                instanceof message.msg {
                    [u8] data {
                        if status < 0 {
                            const onError = config.onError
                            onError(copy socket, status, data)
                            break
                        }
                        const onMessage = config.onMessage
                        onMessage(copy socket, status, data)
                    },
                    null {
                        const onClose = config.onClose
                        onClose(copy socket, status)
                        break
                    }
                }
            }
        }
    }
    return 0
}

fn(async) handleRequest(context: HttpHandlerContext, requestId: u64): null {
    const rawRequest = await __provider_server_request_get(requestId)
    instanceof rawRequest {
        null { return null },
        ProviderRequest raw {
            const request = new(Request) {
                id: raw.id,
                url: raw.url,
                method: raw.method,
                headers: raw.headers,
                body: new(RequestBody) { id: raw.body, closed: false }
            }
            const fetch = context.fetch
            const response = await fetch(copy request)
            const status = response.status
            const completed = await writeResponse(request.id, response)
            if status == 101 && completed {
                const socket = new(WebSocket) { id: request.id }
                const websocketContext = new(WebSocketHandlerContext) {
                    socket: socket,
                    status: status,
                    config: copy context.websocket
                }
                const websocketThread = createThread(webSocketHandler, websocketContext)
                if !websocketThread::spawn() {
                    await socket::close()
                }
            }
        }
    }
    return null
}

fn httpHandler(context: HttpHandlerContext): i32 {
    loop {
        const ticket = await receiveMessage()
        instanceof ticket {
            null {},
            [u8] ticketBytes {
                match parse<u64>(ticketBytes) {
                    ParseResult<u64>::Ok(requestId) {
                        await handleRequest(copy context, requestId)
                    },
                    ParseResult<u64>::Err(_) {}
                }
            }
        }
        if !sendToParent(stringify(getSelfId())) {
            return 1
        }
    }
    return 0
}

export fn Server::start(server: Server): null {
    if server.handlers <= 0 {
        return null
    }
    const server_id = await __provider_server_bind(server.port, <u32> server.handlers)
    const context = new(HttpHandlerContext) {
        fetch: server.fetch,
        websocket: server.websocket
    }
    const handlers = HttpHandlerPool::create(server.handlers)
    var createdHandlers: i32 = 0
    loop {
        if createdHandlers >= server.handlers {
            break
        }
        const handler = createThread(httpHandler, copy context)
        if !handler::spawn() {
            return null
        }
        if !handlers::addAvailable(handler.id) {
            return null
        }
        createdHandlers += 1
    }

    loop {
        handlers::drainCompleted()
        instanceof handlers::takeAvailable() {
            i64 handlerId {
                if !handlers::addBusy(handlerId) {
                    return null
                }
                const requestId = await __provider_server_accept(server_id)
                if !sendTo(handlerId, stringify(requestId)) {
                    return null
                }
            },
            null {
                const completed = await receiveMessage()
                instanceof completed {
                    null {},
                    [u8] workerId {
                        match parse<i64>(workerId) {
                            ParseResult<i64>::Ok(id) { handlers::release(id) },
                            ParseResult<i64>::Err(_) {}
                        }
                    }
                }
            }
        }
    }
    return null
}

export fn(async) WebSocket::send(ws: WebSocket, data: [u8]): bool => ws_send(ws, data)
export fn(async) WebSocket::close(ws: WebSocket): bool => ws_close(ws)
