import { stringify, Parsed, Stringable } from "format"
import { concat, interpolate } from "text"
import { println } from "std/io"
import ansi from "format/ansi"

fn stringifyColored(value: Parsed | [u8] | Stringable): [u8] {
  return instanceof value {
    [u8] text => ansi::green()::apply(text),
    bool flag => ansi::magenta()::apply(stringify(flag)),
    null => ansi::style()::dim()::apply("null"),
    
    i8 n => ansi::yellow()::apply(stringify(n)),
    i16 n => ansi::yellow()::apply(stringify(n)),
    i32 n => ansi::yellow()::apply(stringify(n)),
    i64 n => ansi::yellow()::apply(stringify(n)),
    u8 n => ansi::yellow()::apply(stringify(n)),
    u16 n => ansi::yellow()::apply(stringify(n)),
    u32 n => ansi::yellow()::apply(stringify(n)),
    u64 n => ansi::yellow()::apply(stringify(n)),
    f32 n => ansi::yellow()::apply(stringify(n)),
    f64 n => ansi::yellow()::apply(stringify(n)),
    
    Stringable item => ansi::cyan()::apply(stringify(item)),
  }
}

fn buildMessage(
  tag: [u8], 
  tagStyle: ansi::Style, 
  message: [u8], 
  values: [Parsed | [u8] | Stringable]
): [u8] {
  var msg = tagStyle::apply(tag)
  
  if tag.length > 0 {
    msg = concat(msg, " ")
  }
  
  var stringifiedValues = new([[u8]], values.length)
  var j = 0
  for val in values {
    stringifiedValues[j] = stringifyColored(val)
    j += 1
  }

  var prevByte: u8 = 0
  var consumed = 0
  for byte in message {
    if prevByte == 123 && byte == 125 {
      consumed += 1
      prevByte = 0
    } else {
      prevByte = byte
    }
  }

  msg = concat(msg, interpolate(message, stringifiedValues))

  var current = 0
  for val in stringifiedValues {
    if current >= consumed {
      msg = concat(concat(msg, " "), val)
    }
    current += 1
  }

  return msg
}

export fn log(
  message: [u8],
  ...values: [Parsed | [u8] | Stringable]
): null {
  println(buildMessage("", ansi::style(), message, values))
  return null
}

export fn info(message: [u8], ...values: [Parsed | [u8] | Stringable]): null {
  println(buildMessage("[INFO]", ansi::blue()::bold(), message, values))
  return null
}

export fn debug(message: [u8], ...values: [Parsed | [u8] | Stringable]): null {
  println(buildMessage("[DEBUG]", ansi::style()::dim(), message, values))
  return null
}

export fn warn(message: [u8], ...values: [Parsed | [u8] | Stringable]): null {
  println(buildMessage("[WARN]", ansi::yellow()::bold(), message, values))
  return null
}

export fn error(message: [u8], ...values: [Parsed | [u8] | Stringable]): null {
  println(buildMessage("[ERROR]", ansi::red()::bold(), message, values))
  return null
}
