  if trimmed.length > 2 && (trimmed[0] ?? <u8> 0) == 48 {
    var b1 = (trimmed[1] ?? <u8> 0)
    if b1 == 120 || b1 == 88 {
      base = 16
      start = 2
    } else if b1 == 98 || b1 == 66 {
      base = 2
