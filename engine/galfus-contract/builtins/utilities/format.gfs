// format - pure Galfus formatting and parsing helpers.

export type Parsed = int | uint | float | bool | null 

export choice ParseResult<V: Parsed> {
  Ok(V),
  Err([u8]),
}

export constraint Stringable {
  fn stringify(): [u8]
}

fn append(a: [u8], b: [u8]): [u8] {
  var result = new([u8], a.length + b.length)
  var i: i32 = 0
  for byte in copy a {
    result[i] = byte
    i += 1
  }
  for byte in copy b {
    result[i] = byte
    i += 1
  }
  return result
}

fn bytesEqual(a: [u8], b: [u8]): bool {
  if a.length != b.length {
    return false
  }

  var index = 0

  loop {
    if index >= a.length {
      break
    }

    if a[index] != b[index] {
      return false
    }

    index += 1
  }

  return true
}

fn stringifyUint64(value: u64): [u8] {
  if value == 0 {
    return "0"
  }

  var n = value
  var len: i32 = 0
  loop {
    if n <= 0 {
      break
    }
    len += 1
    n = n / 10
  }

  var digits = new([u8], len)
  n = value
  var i = len - 1
  loop {
    if n <= 0 {
      break
    }
    digits[i] = (n % 10) + <u64> 48
    i -= 1
    n = n / 10
  }

  return digits
}

fn stringifyInt64(value: i64): [u8] {
  if value < 0 {
    return append("-", stringifyUint64(<u64> -value))
  }

  return stringifyUint64(<u64> value)
}

fn stringifyFloat64(value: f64): [u8] {
  if value < 0 {
    return append("-", stringifyFloat64(-value))
  }

  var whole = <u64> value
  var fraction = value - <f64> whole
  var cents = <u64> ((fraction * 100.0) + 0.5)

  if cents == 100 {
    whole = whole + 1
    cents = 0
  }

  var decimals = stringifyUint64(cents)

  if cents < 10 {
    decimals = append("0", decimals)
  }

  return append(append(stringifyUint64(whole), "."), decimals)
}

fn stringifyBool(value: bool): [u8] {
  if value {
    return "true"
  }

  return "false"
}

export fn stringify(value: Parsed | [u8] | Stringable): [u8] {
  return instanceof value {
    [u8] text => text,
    bool flag => stringifyBool(flag),
    null => "null",

    i8 n => stringifyInt64(n),
    i16 n => stringifyInt64(n),
    i32 n => stringifyInt64(n),
    i64 n => stringifyInt64(n),

    u8 n => stringifyUint64(n),
    u16 n => stringifyUint64(n),
    u32 n => stringifyUint64(n),
    u64 n => stringifyUint64(n),

    f32 n => stringifyFloat64(n),
    f64 n => stringifyFloat64(n),

    Stringable item => item::stringify(),

    _ => "unknown",
  }
}


fn trimBytes(s: [u8]): [u8] {
  var start = 0
  var end = s.length
  
  loop {
    if start >= end { break }
    var b = s[start] ?? <u8> 0
    if b == 32 || b == 9 || b == 10 || b == 13 {
      start += 1
    } else {
      break
    }
  }

  loop {
    if end <= start { break }
    var b = s[end - 1] ?? <u8> 0
    if b == 32 || b == 9 || b == 10 || b == 13 {
      end -= 1
    } else {
      break
    }
  }

  if start == 0 && end == s.length { return s }
  if start >= end { return "" }
  
  var res = new([u8], end - start)
  var i = 0
  loop {
    if start >= end { break }
    res[i] = s[start]
    i += 1
    start += 1
  }
  return res
}

fn parseInt8(s: [u8]): ParseResult<i8> {
  var trimmed = trimBytes(s)
  if trimmed.length == 0 { return ParseResult<i8>::Err("empty input") }

  var negative = false
  var start = 0
  if (trimmed[0] ?? <u8> 0) == 45 {
    negative = true
    start = 1
  } else if (trimmed[0] ?? <u8> 0) == 43 {
    start = 1
  }

  var base: i64 = 10
  if trimmed.length > start + 2 && (trimmed[start] ?? <u8> 0) == 48 {
    var b1 = (trimmed[start + 1] ?? <u8> 0)
    if b1 == 120 || b1 == 88 {
      base = 16
      start += 2
    } else if b1 == 98 || b1 == 66 {
      base = 2
      start += 2
    } else if b1 == 111 || b1 == 79 {
      base = 8
      start += 2
    }
  }

  var value: i64 = 0
  var hasDigit = false
  var i = start

  loop {
    if i >= trimmed.length { break }
    var byte = trimmed[i] ?? <u8> 0
    i += 1

    if byte == 95 {
      continue
    }

    var digit: i64 = 0
    if byte >= 48 && byte <= 57 {
      digit = <i64>(byte - 48)
    } else if byte >= 97 && byte <= 102 {
      digit = <i64>(byte - 97) + 10
    } else if byte >= 65 && byte <= 70 {
      digit = <i64>(byte - 65) + 10
    } else {
      return ParseResult<i8>::Err("invalid digit")
    }

    if digit >= base {
      return ParseResult<i8>::Err("invalid digit for base")
    }

    hasDigit = true
    value = value * base + digit
  }

  if !hasDigit {
    return ParseResult<i8>::Err("empty input")
  }

  if negative {
    return ParseResult<i8>::Ok(<i8> -value)
  }

  return ParseResult<i8>::Ok(<i8> value)
}

