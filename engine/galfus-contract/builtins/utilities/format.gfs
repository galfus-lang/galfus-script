fn parseFloat32(s: [u8]): ParseResult<f32> {
  var trimmed = trimBytes(s)
  if trimmed.length == 0 { return ParseResult<f32>::Err("empty input") }

  var value: f64 = 0.0
  var fraction: f64 = 0.0
  var divisor: f64 = 10.0
  var negative = false
  var hasWholeDigit = false
  var hasFractionDigit = false
  var afterDot = false
  
  var start = 0
  if (trimmed[0] ?? <u8> 0) == 45 {
    negative = true
    start = 1
  } else if (trimmed[0] ?? <u8> 0) == 43 {
    start = 1
  }

  var i = start
  loop {
    if i >= trimmed.length { break }
    var byte = trimmed[i] ?? <u8> 0
    i += 1

    if byte == 95 { continue }
    
    if byte == 46 {
      if afterDot || !hasWholeDigit {
        return ParseResult<f32>::Err("invalid float")
      }
      afterDot = true
    } else {
      if byte < 48 || byte > 57 {
        return ParseResult<f32>::Err("invalid digit")
      }

      var digit = <f64> (byte - 48)

      if afterDot {
        hasFractionDigit = true
        fraction = fraction + digit / divisor
        divisor = divisor * 10.0
      } else {
        hasWholeDigit = true
        value = value * 10.0 + digit
      }
    }
  }

  if !hasWholeDigit {
    return ParseResult<f32>::Err("empty input")
  }

  if afterDot && !hasFractionDigit {
    return ParseResult<f32>::Err("invalid float")
  }

  value = value + fraction

  if negative {
    return ParseResult<f32>::Ok(<f32> -value)
  }

  return ParseResult<f32>::Ok(<f32> value)
}

fn parseFloat64(s: [u8]): ParseResult<f64> {
  var trimmed = trimBytes(s)
  if trimmed.length == 0 { return ParseResult<f64>::Err("empty input") }

  var value: f64 = 0.0
  var fraction: f64 = 0.0
  var divisor: f64 = 10.0
  var negative = false
  var hasWholeDigit = false
  var hasFractionDigit = false
  var afterDot = false
  
  var start = 0
  if (trimmed[0] ?? <u8> 0) == 45 {
    negative = true
    start = 1
  } else if (trimmed[0] ?? <u8> 0) == 43 {
    start = 1
  }

  var i = start
  loop {
    if i >= trimmed.length { break }
    var byte = trimmed[i] ?? <u8> 0
    i += 1

    if byte == 95 { continue }
    
    if byte == 46 {
      if afterDot || !hasWholeDigit {
        return ParseResult<f64>::Err("invalid float")
      }
      afterDot = true
    } else {
      if byte < 48 || byte > 57 {
        return ParseResult<f64>::Err("invalid digit")
      }

      var digit = <f64> (byte - 48)

      if afterDot {
        hasFractionDigit = true
        fraction = fraction + digit / divisor
        divisor = divisor * 10.0
      } else {
        hasWholeDigit = true
        value = value * 10.0 + digit
      }
    }
  }

  if !hasWholeDigit {
    return ParseResult<f64>::Err("empty input")
  }

  if afterDot && !hasFractionDigit {
    return ParseResult<f64>::Err("invalid float")
  }

  value = value + fraction

  if negative {
    return ParseResult<f64>::Ok(<f64> -value)
  }

  return ParseResult<f64>::Ok(<f64> value)
}

fn parseBool(s: [u8]): ParseResult<bool> {
  var trimmed = trimBytes(s)
  if trimmed.length == 4 {
    var ok = true
    var index = 0
    for byte in trimmed {
      if index == 0 && byte != 116 { ok = false }
      if index == 1 && byte != 114 { ok = false }
      if index == 2 && byte != 117 { ok = false }
      if index == 3 && byte != 101 { ok = false }
      index += 1
    }
    if ok { return ParseResult<bool>::Ok(true) }
  }

  if trimmed.length == 5 {
    var ok = true
    var index = 0
    for byte in trimmed {
      if index == 0 && byte != 102 { ok = false }
      if index == 1 && byte != 97 { ok = false }
      if index == 2 && byte != 108 { ok = false }
      if index == 3 && byte != 115 { ok = false }
      if index == 4 && byte != 101 { ok = false }
      index += 1
    }
    if ok { return ParseResult<bool>::Ok(false) }
  }

  return ParseResult<bool>::Err("invalid bool")
}

fn parseNull(s: [u8]): ParseResult<null> {
  var trimmed = trimBytes(s)
  if trimmed.length == 4 {
    var ok = true
    var index = 0
    for byte in trimmed {
      if index == 0 && byte != 110 { ok = false }
      if index == 1 && byte != 117 { ok = false }
      if index == 2 && byte != 108 { ok = false }
      if index == 3 && byte != 108 { ok = false }
      index += 1
    }
    if ok { return ParseResult<null>::Ok(null) }
  }

  return ParseResult<null>::Err("invalid null")
}

export fn parse<T: Parsed>(s: [u8]): ParseResult<T> {
  return typeof T {
    i8 => parseInt8(s),
    i16 => parseInt16(s),
    i32 => parseInt32(s),
    i64 => parseInt64(s),

    u8 => parseUint8(s),
    u16 => parseUint16(s),
    u32 => parseUint32(s),
    u64 => parseUint64(s),

    f32 => parseFloat32(s),
    f64 => parseFloat64(s),

    bool => parseBool(s),
    null => parseNull(s),

    _ => ParseResult<T>::Err("unsupported type for parse")
  }
}
