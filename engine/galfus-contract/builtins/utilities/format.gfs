fn parseUint64(s: [u8]): ParseResult<u64> {
  var trimmed = trimBytes(s)
  if trimmed.length == 0 { return ParseResult<u64>::Err("empty input") }

  var base: u64 = 10
  var start = 0

  if trimmed.length > 2 && (trimmed[0] ?? <u8> 0) == 48 {
    var b1 = (trimmed[1] ?? <u8> 0)
    if b1 == 120 || b1 == 88 {
