import { read } from 'std/io'
import { stringify, parse, ParseResult } from 'format'
import { cyan, green } from 'format/ansi'
import { log } from 'log'

export fn main(_args: [[u8]]): i32 {
  log(green()::apply("Please enter a number:"))
  var r1 = parse<i32>(read())
  var matchResult = match r1 {
    ParseResult::Ok(v) => "Ok",
    ParseResult::Err(e) => "Err",
  }
  log("Is r1 ok? {}", matchResult)
  
  return 0
}
