import { println } from "std/io"
import { createThread, getMessage, getThread, hasMessages } from "std/thread"

fn worker(_context: null): i32 {
  println("Runing on thread")

  if hasMessages() {
    return 10
  }

  if getMessage() != null {
    return 11
  }

  return 7
}

export fn main(_args: [[u8]]): i32 {
  if getThread("missing-thread") != null {
    return 1
  }

  const thread = createThread(worker, null, "showcase-worker")
  if thread::isRunning() || thread::isExited() || thread::exitReason() != null {
    return 2
  }

  const found = getThread("showcase-worker")
  if found == null {
    return 3
  }

  println("starting thread")
  const started = thread::spawn()
  if !started {
    return 4
  }

  const exitCode = thread::wait()

  const exited = thread::isExited()
  const running = thread::isRunning()
  const exitReason = thread::exitReason()
  
  if !exited {
    println("thread is not marked exited after wait")
    return 5
  }
  if running {
    println("thread is still marked running after wait")
    return 5
  }
  if exitReason == null {
    println("thread exit reason is absent after wait")
    return 5
  }

  const startedAgain = thread::spawn()
  if startedAgain {
    println("an exited thread can be spawned again")
    return 6
  }

  println("thread showcase completed")
  return 0
}
