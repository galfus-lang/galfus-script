import { ByteBuffer, CollectResult, fromBytes, ReadStreamResult, BytesStream } from "std/stream"
import { println } from "std/io"
import { equals } from "text"

struct Counter {
  value: i32
}

fn(async) increment(counter: Counter): null {
  counter.value += 1
}

export fn main(_args: [[u8]]): i32 {
  const counter = new(Counter) { value: 0 }
  await increment(counter)
  if counter.value != 1 { return 1 }

  const source = fromBytes("stream")
  const buffer = ByteBuffer::create()
  if buffer.length != 0 { return 2 }
  const result = await source::next()
  match result {
    ReadStreamResult::Data(bytes) {
      if !equals(bytes, "stream") { return 3 }
    },
    _ { println("Failed match! got: "); return 4 }
  }

  const end = await source::next()
  var ended = false
  match end {
    ReadStreamResult::Data(_) { return 5 },
    ReadStreamResult::Error(_) { return 6 },
    ReadStreamResult::End { ended = true }
  }
  if !ended { return 7 }

  const collected = await buffer::collect(fromBytes("collected"))
  match collected {
    CollectResult::Data(bytes) {
      if !equals(bytes, "collected") { return 8 }
    },
    CollectResult::LimitExceeded { return 9 },
    CollectResult::Error(_) { return 10 }
  }

  const limited = await ByteBuffer::create()::collect(fromBytes("limit"), 4)
  var limited_result = false
  match limited {
    CollectResult::Data(_) { return 11 },
    CollectResult::Error(_) { return 11 },
    CollectResult::LimitExceeded { limited_result = true }
  }
  if !limited_result { return 11 }

  const cancelled = fromBytes("cancelled")
  await cancelled::cancel()
  const cancelled_result = await cancelled::next()
  var cancelled_ended = false
  match cancelled_result {
    ReadStreamResult::Data(_) { return 12 },
    ReadStreamResult::Error(_) { return 12 },
    ReadStreamResult::End { cancelled_ended = true }
  }
  if !cancelled_ended { return 12 }

  println("ok")
  return 0
}
