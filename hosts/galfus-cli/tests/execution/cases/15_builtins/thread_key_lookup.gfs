import { createThread, getThread } from "std/thread"
import { println } from "std/io"

fn worker(previous_key: [u8], next_key: [u8]): i32 {
  const previous = getThread(previous_key)
  if previous == null {
    return 1
  }
  const next = getThread(next_key)
  if next == null {
    return 2
  }
  var state: i32 = 1
  for _ in 0..2 {
    if !next::send("message") {
      return 3
    }
    const received = instanceof previous::receiveMessage(1000) {
      [u8] message => <i32> message.length,
      null => 0,
    }
    state = state + received
  }
  return state
}

fn first_worker(_context: null): i32 => worker("fourth", "second")
fn second_worker(_context: null): i32 => worker("first", "third")
fn third_worker(_context: null): i32 => worker("second", "fourth")
fn fourth_worker(_context: null): i32 => worker("third", "first")

export fn main(_args: [[u8]]): i32 {
  const first = createThread(first_worker, null, "first")
  const second = createThread(second_worker, null, "second")
  const third = createThread(third_worker, null, "third")
  const fourth = createThread(fourth_worker, null, "fourth")
  const firstSpawned = first::spawn()
  const secondSpawned = second::spawn()
  const thirdSpawned = third::spawn()
  const fourthSpawned = fourth::spawn()
  if !firstSpawned || !secondSpawned || !thirdSpawned || !fourthSpawned {
    return 4
  }
  const first_result = first::wait()
  const second_result = second::wait()
  const third_result = third::wait()
  const fourth_result = fourth::wait()
  if first_result == null || second_result == null || third_result == null || fourth_result == null {
    return 4
  }
  println("ok")
  return 0
}
