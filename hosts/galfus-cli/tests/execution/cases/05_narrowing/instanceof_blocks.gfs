import { println } from "std/io"

type Scalar = i32 | bool | null

fn finish(value: i32): i32 { return value }

fn evaluate(value: Scalar): i32 {
  return instanceof value {
    i32 number {
      var total = number;
      total += 2
      return finish(total)
    },
    bool flag {
      if flag { return finish(10) }
      return finish(20)
    },
    null {
      return finish(30)
    },
  }
}

export fn main(_args: [[u8]]): i32 {
  if evaluate(5) != 7 { return 1 }
  if evaluate(true) != 10 { return 2 }
  if evaluate(false) != 20 { return 3 }
  if evaluate(null) != 30 { return 4 }
  println("ok")
  return 0
}
