import { println } from "std/io"

enum Mode { Draft, Published }

struct User {
  id: i32,
}

type ArticleMode = Mode
type Account = User
type Mapper = fn (i32): i32

fn mode_code(mode: ArticleMode): i32 {
  return match mode {
    Mode::Draft => 1,
    Mode::Published => 2,
  }
}

fn account_id(account: Account): i32 => account.id
fn increment(value: i32): i32 => value + 1

export fn main(_args: [[u8]]): i32 {
  const mode: ArticleMode = Mode::Published
  const account: Account = new { id: 41 }
  const mapper: Mapper = increment

  if mode_code(mode) != 2 { return 1 }
  if account_id(account) != 41 { return 2 }
  if mapper(account.id) != 42 { return 3 }

  println("ok")
  return 0
}
